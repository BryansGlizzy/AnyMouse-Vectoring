# AnyMouse-Vectoring .gitignore

# Binaries
anymouse
libanymouse_faf.so
faf_launcher
octant_daemon

# Object files and Linux kernel modules
*.o
*.ko
*.so

# Upstream reference sources
FpsAimForge-src/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Temporary and editor files
.rbxsync-trash/
.DS_Store
*.swp
*.bak
*~

# Local custom profiles
profile.json

# External tooling
rea/

# Per-flick CSV logs
logs/
